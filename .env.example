DAJIALA_API_KEY=你的大佳啦API_KEY
DAJIALA_VERIFY_CODE=

# 路径勿以 \ 结尾（Windows bat 传参 "路径\" 会转义引号，导致 WinError 123）；bat 已自动去尾 \，仍建议不写。
# PARSE_INPUT_ROOT=output/reports/gzh
# PARSE_OUTPUT_ROOT=reports/gzh
# 抓取/解析留痕根目录（与 PARSE_INPUT_ROOT 分开更清晰）：
#   {EXPORT_AUDIT_JSON_ROOT}/{业务日yyyyMMdd}/export_{run_id}/{业务日}_{公众号}.trace.json
#   {PARSE_AUDIT_JSON_ROOT}/{业务日yyyyMMdd}/parse_{run_id}/{业务日}_{公众号}.trace.json
# EXPORT_AUDIT_JSON_ROOT=output/reports/gzh/audit
# PARSE_AUDIT_JSON_ROOT=output/reports/gzh/audit

# 公众号列表：默认读取项目下 config/accounts.txt（每行一个名称，# 为注释）
# 可复制 config/accounts.example.txt 为 config/accounts.txt 后修改
# GZH_DAJIALA_ACCOUNTS_FILE=config/accounts.txt

# 大佳啦导出：未传 CLI --mode/--max-pages 时使用（可被参数覆盖）。
# GZH_DAJIALA_FETCH_MODE：today | yesterday | latest | all（未配置默认 today）
# 抓取落盘与无参解析默认业务日均与此一致：today/latest/all→当天目录，yesterday→前一天目录
#   today=post_condition 当天列表，再按 --date 过滤
#   yesterday=post_history 分页（accounts.txt 中文名写入请求体 name 字段），过滤「基准日减 1 天」；建议配合 GZH_DAJIALA_FETCH_MAX_PAGES
#   latest=post_condition 最新一页；all=post_history 分页（不按日过滤）
# 正文：both=并行 monitor/v3/article_html + 直连文章 url（默认，对比结果在 _compare/）；dajiala | url
# GZH_DAJIALA_BODY_SOURCES=both
# url 直连：full=整页响应原样落盘（默认）；extract=只抽 #js_content 再 wrap_html
# GZH_DAJIALA_URL_FETCH_MODE=full
# url 落盘前将 data-src 写入 src、去掉正文 visibility:hidden，便于本地打开看图（默认开启）
# GZH_WEIXIN_OFFLINE_NORMALIZE=1
# GZH_DAJIALA_FETCH_MODE=today
# GZH_DAJIALA_FETCH_MODE=yesterday
# # all / yesterday 的 post_history 最大页数（yesterday 抓前一天时建议 5～10）
# GZH_DAJIALA_FETCH_MAX_PAGES=10

# 聚合解析：已取消规则/关键词兜底，必须配置下方大模型（否则会 job 失败）。
# 聚合解析 · 大模型（OpenAI Chat Completions 兼容）
# DeepSeek：填 DEEPSEEK_API_KEY；也可用 ALIYUN_DEEPSEEK_API_KEY（二选一）
DEEPSEEK_API_KEY=
ALIYUN_DEEPSEEK_API_KEY=
# 兼容入口：官方默认 https://api.deepseek.com/v1
# 阿里云百炼 DeepSeek 请将 base 改为控制台提供的 OpenAI 兼容地址，例如：
# DEEPSEEK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-chat
#
# 多模态配图（两段式）：识图模型(VL) + 正文归纳模型；默认 Bearer 与 DEEPSEEK 主密钥相同。
# 若主密钥仅能调用 DEEPSEEK_MODEL、不能调用 VL，请单独配置：
# GZH_VISION_PRECLEAN_API_KEY=（百炼等有 VL 权限的 Key）
# # GZH_VISION_PRECLEAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# （可选；不设则沿用 DEEPSEEK_API_BASE）
# # GZH_VISION_PRECLEAN_HTTP_SLUG=deepseek_chat_completions（可选；不设则沿用主任务的 trace http 前缀）
# 1) GZH_LLM_VISION=1
# 2) GZH_VISION_PRECLEAN_MODEL=控制台英文 model id（多模态 / VL）
# 主归纳模型仍为 DEEPSEEK_MODEL；VL 仅用 GZH_VISION_PRECLEAN_MODEL。
# GZH_LLM_VISION=1
# GZH_VISION_PRECLEAN_MODEL=
# # GZH_VISION_PRECLEAN_TIMEOUT_SECONDS=300
# # GZH_VISION_PRECLEAN_TEMPERATURE=0.1
# # GZH_VISION_PRECLEAN_MAX_CHARS=12000
# # 第一阶段识图写入 trace 的「配图识读」正文最大字节（超限则 head/tail+sha256，与 AUDIT_STEP_BODY_MAX_BYTES 取小）
# # GZH_VISION_TRACE_READING_MAX_BYTES=262144
# # 插图送入 VL 的策略：默认 https_first（外链 https 先试直传 URL，失败后同一篇再打一轮全员本机抓取+data-uri）；data_uri_only=始终本机抓取
# # GZH_VISION_IMAGE_DELIVERY=https_first
# # 汇入 .trace.json 顶层 summary.vision_preclean_readings[].reading_notes 的单篇字节上限（与 AUDIT_STEP_BODY_MAX_BYTES / trace 写入上限取小）
# # GZH_VISION_AUDIT_SUMMARY_READING_MAX_BYTES=262144
# # VL 配图识读正文落盘位置（同一 trace.json）：summary.vision_preclean_model_outputs[].model_output_text；成品 HTML 仅含四维度，不展示配图识读区块。
# # 百炼 Thinking 等与 OpenAI 兼容层约定的顶层字段示例：
# # GZH_VISION_PRECLEAN_EXTRA_JSON={"enable_thinking":true}

# GZH_VISION_MAX_IMAGES_PER_ARTICLE=6
# 识图时跳过正文内 data-type="gif" 的微信动图（不占配图张数上限）
# GZH_VISION_MAX_IMAGE_BYTES=3145728
# GZH_VISION_FETCH_TIMEOUT_SECONDS=45
# GZH_VISION_REFERER=https://mp.weixin.qq.com/
#
# 「插图镜像」PARSE_IMAGE_MODE=mirror 时 img 的 src 会改为本地文件名；流程会写入 data-gzh-vision-src 保存原 CDN 链接，启用 GZH_LLM_VISION 时识图仍可远程下载。
#
# OpenAI 兼容「纯文本 Chat」请用语义归纳类模型（如 deepseek-chat）。
# 未开 GZH_LLM_VISION 时，模型名若含 OCR 常为识图通道，用文本 /chat/completions 可能异常，请慎用。
# 若设 0/false/no 且未配 OpenAI，则无法解析（不会回退到规则引擎）。
# GZH_USE_DEEPSEEK=1

# 三阶段：1) 单篇价值预筛 2) 四维度简报 3) 研究员+投资经理审稿（均写入 .trace.json）
# 仅影响预筛 API 失败是否整 job 中止；四维度/审稿本身已要求大模型成功。
# GZH_PARSE_STRICT_LLM=1

# GZH_VALUE_GATE_LLM=1
# 预筛调用失败时 keep=仍参与解析，discard=剔除
# GZH_VALUE_GATE_ON_ERROR=keep
# GZH_VALUE_GATE_MAX_CHARS=8000
# 可选：整段覆盖价值预筛 system 提示（占位符 {vision_line}）；默认提示已含宏观/地缘政治可保留，禁止硬编码关键词判篇
# GZH_VALUE_GATE_SYSTEM=
# GZH_DIMENSION_REVIEW_LLM=1

# GZH_LLM_TIMEOUT_SECONDS=180
# GZH_LLM_TEMPERATURE=0.2
# 瞬断/对端强制关连接(如 WinError 10054)/429/5xx 网关错误时，除首次外再重试的次数（指数退避）。
# GZH_LLM_HTTP_RETRIES=3
# GZH_LLM_RETRY_BASE_SECONDS=2
#
# 四维度：单次请求最多篇数（默认 3）；多则分批再调用「合并」，减轻单次体量导致网关 Remote end closed / without response。
# 设为 0 或 all 则多篇仍一次送出。
# GZH_DIMENSION_ARTICLES_PER_CALL=3
# GZH_DIMENSION_CHARS_PER_ARTICLE=6000

# 可选：用 OpenAI 替代（需同时 GZH_DIMENSION_LLM=1，且未启用 DeepSeek）
# OPENAI_API_KEY=
# GZH_DIMENSION_LLM=1
# GZH_LLM_MODEL=gpt-4o-mini

# 解析产出：默认「日期/公众号」目录下合并为一页 summary.html。若需每个源 .html 各生成一份成品（同名 stem）：
# GZH_AGGREGATE_ONE_HTML_PER_SOURCE=1
# 价值预筛判为无价值的篇目不生成成品 HTML，也不做四维度/审稿（仅写入 audit trace）。
#   python -m gzh_pipeline.cli.parse ... --idempotent-skip
# Windows 批处理：set PARSE_SKIP_IF_SAME=1（见 run_aggregate_parse.bat）
# 控制台长时间无输出多半是等待大模型：批处理未设置时默认 GZH_PARSE_PROGRESS=1，会打印 [gzh-parse] 阶段提示；若需静默置 0。
# 多公众号并行解析（同一业务日下多个账号目录）：线程数 1～10，默认 10；仅 1 个账号时自动串行。
# GZH_PARSE_ACCOUNT_WORKERS=10
# 或 CLI：python -m gzh_pipeline.cli.parse --account-workers 4
